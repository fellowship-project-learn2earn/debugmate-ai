# Backend reads these directly, and ai_engine/ (imported as a sibling
# package) reads its own .env for the gateway credentials -- see
# ai_engine/.env.example for BAALEBOS_API_URL / BAALEBOS_API_KEY.

# Your deployed frontend's real origin, once live. Vite's local dev
# server (http://localhost:5173) is already allowed by default.
FRONTEND_ORIGIN=
